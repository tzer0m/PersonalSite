@page
@using PersonalSite.Models
@model CountriesModel
@{
    ViewData["Title"] = "Countries";
}

<style>
    @Html.Raw(Model.MapStyles)
</style>

<section class="term">
    <a class="link-row term-back" asp-page="/Index">&lt;- back</a>

    <header class="term-header">
        <h1 class="term-title">countries visited</h1>
    </header>

    <div class="map-wrap" data-visited="@Model.VisitedCodes" data-globe="@Url.Content("~/data/globe.json")">
        <div class="map-view" data-view="2d" hidden>
            @Html.Raw(Model.MapSvg)
        </div>
        <div class="map-view globe-view" data-view="3d">
            <canvas class="world-globe" aria-label="Interactive globe of visited countries"></canvas>
            <span class="globe-tip" hidden></span>
        </div>
    </div>

    <div class="map-bar">
        <div class="map-toggle" role="group" aria-label="Map view">
            <button type="button" class="toggle-button" data-map-view="3d" aria-pressed="true">3d globe</button>
            <button type="button" class="toggle-button" data-map-view="2d" aria-pressed="false">2d map</button>
        </div>
    </div>

    <hr class="term-rule" />

    <h2 class="group-label term-section">visited <span class="muted">@Model.Visited.Count</span></h2>
    <ul class="country-list">
        @foreach (Country country in Model.Visited)
        {
            <li><span class="mark-visited">✓</span> <span class="muted">@country.Code</span> @country.Name</li>
        }
    </ul>
</section>

@section Scripts {
    <script src="~/lib/d3/d3-array.min.js" asp-append-version="true"></script>
    <script src="~/lib/d3/d3-geo.min.js" asp-append-version="true"></script>
    <script src="~/lib/topojson/topojson-client.min.js" asp-append-version="true"></script>
    <script src="~/js/countries.js" asp-append-version="true"></script>
}